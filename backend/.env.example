# Free Groq API key: https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# Optional overrides — defaults already point at free Groq-hosted models.
# Not every Groq key has vision-model access; text-only always works.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional second free provider, used automatically if Groq is unavailable,
# rate-limited, or a model id goes stale: https://openrouter.ai/keys
# Free-tier model slugs churn often — see https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# No key needed for either provider above? The app still works — it falls
# back to a built-in, rule-based local responder so there's always a demo.

# edge-tts needs no key. Run `edge-tts --list-voices` to see all free options.
# Used for the male/female doctor voice toggle in the UI.
TTS_VOICE_FEMALE=en-US-AriaNeural
TTS_VOICE_MALE=en-US-AndrewNeural

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP limit on /api/consult ("N/period" — slowapi syntax: second/minute/hour/day).
# Protects the shared free-tier AI quota from a single user spamming requests.
RATE_LIMIT=8/minute
